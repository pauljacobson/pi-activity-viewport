{
  "name": "pi-activity-viewport",
  "version": "0.1.0",
  "private": true,
  "description": "A bounded activity viewport extension for pi.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:latest-pi": "bash ./scripts/check-latest-pi.sh"
  },
  "pi": {
    "extensions": [
      "./extensions/activity-viewport/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "^22.20.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
